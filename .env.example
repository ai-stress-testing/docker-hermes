# Copy this file to .env and adjust as needed: cp .env.example .env

# OpenAI-compatible endpoint for your locally-running LM Studio server.
# host.docker.internal is how the sandboxed container reaches services on
# the host (default LM Studio port is 1234) without joining the host network.
LMSTUDIO_URL=http://host.docker.internal:1234/v1

# Model identifier as loaded/exposed by LM Studio.
MODEL_NAME=local-model

# The only directory the agent is allowed to write to; maps to the single
# ./workspace bind mount defined in docker-compose.yml. Leave as /workspace
# unless you also change the container-side mount path in docker-compose.yml.
WORKSPACE_DIR=/workspace

# Hard cap on tool-call/reasoning loop iterations before the agent gives up
# and exits non-zero.
MAX_ITERATIONS=10

# Per-request timeout (seconds) when calling the LM Studio API.
REQUEST_TIMEOUT=60.0

# The task for the agent to perform. Can also be passed as a CLI arg to
# `docker compose run --rm agent "your task here"`, which takes precedence.
TASK_PROMPT=

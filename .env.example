# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# Every variable already has a safe default baked into docker-compose.yml
# (see the ${VAR:-default} syntax there), so an empty or missing .env
# still works. This file exists to document what's tunable and to make
# `docker compose up` reproducible without editing the compose file.

### LM Studio connection (backend -> LM Studio, running on your host) ###

# Base URL of LM Studio's OpenAI-compatible API, as reached from inside
# the backend container. LM Studio itself is not a service in this
# stack — it's your existing local LM Studio install (see
# docker-compose.yml for why there's no `lmstudio` service to build).
#
# host.docker.internal resolves to the host machine. Docker Desktop
# (macOS/Windows) maps this automatically; docker-compose.yml also adds
# an explicit `extra_hosts: host.docker.internal:host-gateway` entry on
# the backend service so this works on native Docker Engine on Linux
# too. Make sure LM Studio's local server is started and bound to a
# host/port reachable this way (LM Studio's default local server port is
# 1234).
LMSTUDIO_URL=http://host.docker.internal:1234

# Model name used when a chat request doesn't specify one. Must match a
# model already loaded in LM Studio (see LM Studio's "Local Server" tab).
DEFAULT_MODEL=default

# Seconds to wait for LM Studio to respond to a chat completion request.
# This single value also drives, automatically (no other file to edit):
#   - the nginx reverse proxy's own read/send timeout (REQUEST_TIMEOUT+15s;
#     see hermes/docker-entrypoint.d/20-hermes-config.sh), so raising this
#     doesn't get silently overridden by a shorter hardcoded proxy timeout
#   - docker-compose.yml's `stop_grace_period` on the backend service
#     (=REQUEST_TIMEOUT), so `docker compose down`/recreate doesn't
#     SIGKILL a request that's still legitimately waiting on LM Studio
#   - uvicorn's own graceful-shutdown deadline inside the container
#     (REQUEST_TIMEOUT-5s; see backend/docker-entrypoint.sh), which stays
#     a few seconds ahead of the stop_grace_period deadline above
REQUEST_TIMEOUT=30

# Seconds to wait for LM Studio to respond to the lightweight /ready
# reachability check. Deliberately shorter than REQUEST_TIMEOUT.
READY_CHECK_TIMEOUT=2

# Maximum accepted request body size, in bytes. Requests larger than
# this are rejected with 413 before the body is fully read. Also drives
# nginx's own client_max_body_size (rendered from this same variable —
# see hermes/docker-entrypoint.d/20-hermes-config.sh), so nginx's default
# 1MB cap can't silently override this before the backend ever sees the
# request.
MAX_REQUEST_BODY_BYTES=2000000

# Python standard logging level: DEBUG, INFO, WARNING, or ERROR.
LOG_LEVEL=INFO

### Hermes UI ###

# Host port the Hermes UI is published on (the only host-published port
# in the default stack). Browse to http://localhost:${HERMES_PORT} once
# the stack is up.
HERMES_PORT=8080

# Backend URL baked into the UI's served config.js at container startup,
# fetched by browser-side JS (hermes/app.js). Leave empty (the default):
# the browser then makes a same-origin relative request to the Hermes UI
# itself, which nginx reverse-proxies internally to the backend service
# on hermes-net (see hermes/nginx.conf) — the backend is never published
# to the host and the full browser round-trip works out of the box.
# Only override this if you're pointing the UI at a differently-hosted
# backend; see docker-compose.override.yml.example for direct,
# debugging-only host access to this stack's own backend.
BACKEND_URL=

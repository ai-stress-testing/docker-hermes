# Copy this file to .env and adjust as needed: cp .env.example .env

# Host uid/gid to run as, so files Hermes creates under ./hermes-data
# are owned by you rather than the image's built-in uid (10000) and
# writable by you outside the container. Find yours with `id -u`/`id -g`.
PUID=1000
PGID=1000

# --- LM Studio as the model provider ---
#
# The officially documented, always-correct way to point Hermes at a
# local LM Studio instance is the interactive setup wizard: run LM
# Studio on the host with its OpenAI-compatible server enabled (default
# port 1234), then, on first run:
#
#   docker compose run --rm hermes setup
#
# and pick LM Studio / Custom Endpoint as the provider when prompted,
# with base URL http://host.docker.internal:1234/v1. That choice is
# written into ./hermes-data/config.yaml and persists across runs - no
# env vars required after that.
#
# The env vars below are an optional headless alternative (e.g. for
# scripted/CI setup) that skip the wizard. Confirm the exact variable
# names Hermes expects for your installed version with
# `docker compose run --rm hermes model --help` before relying on
# these - the project's docs describe both a generic "Custom Endpoint"
# provider (OPENAI_BASE_URL/OPENAI_API_KEY) and an LM-Studio-specific
# one (LM_BASE_URL/LM_API_KEY), and which applies can depend on the
# provider you select.
# OPENAI_BASE_URL=http://host.docker.internal:1234/v1
# OPENAI_API_KEY=local-key
